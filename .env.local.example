# Supabase Configuration
# Replace these with your actual Supabase project details
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key


NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=paystack_public_key

# Site origin used in emailed links (password reset, etc.), e.g. https://theismart.org
NEXT_PUBLIC_APP_URL=app-url

# Optional: must match Supabase Auth > Email OTP Expiration (minutes, default 60)
PASSWORD_RESET_EXPIRY_MINUTES=60

# Note: Never commit your actual .env.local file with real keys to version control
# This is just a template file. Copy this to .env.local and add your actual values. 
